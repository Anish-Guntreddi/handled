     1	"""pgvector RAG retrieval over an org's document chunks (FR-DI-5, FR-EM-1).
     2	
     3	Returns chunks with their cosine distance so citations resolve to a document + locator.
     4	Real-semantic when EMBEDDINGS_PROVIDER=gemini; deterministic (but non-semantic) with the
     5	mock provider — which is why evidence *scoring* uses keyword overlap, not vector distance."""
     6	
     7	from __future__ import annotations
     8	
     9	import uuid
    10	
    11	from sqlalchemy import select
    12	from sqlalchemy.ext.asyncio import AsyncSession
    13	
    14	from captureos.models.documents import DocumentChunk
    15	from captureos.providers import get_embeddings
    16	
    17	
    18	async def retrieve_relevant_chunks(
    19	    session: AsyncSession, org_id: uuid.UUID, query_text: str, *, k: int = 5
    20	) -> list[tuple[DocumentChunk, float]]:
    21	    if not query_text.strip():
    22	        return []
    23	    embedding = await get_embeddings().embed([query_text])
    24	    query_vec = embedding.vectors[0]
    25	    distance = DocumentChunk.embedding.cosine_distance(query_vec)
    26	    stmt = (
    27	        select(DocumentChunk, distance.label("distance"))
    28	        .where(DocumentChunk.org_id == org_id, DocumentChunk.embedding.is_not(None))
    29	        .order_by(distance)
    30	        .limit(k)
    31	    )
    32	    rows = (await session.execute(stmt)).all()
    33	    return [(row[0], float(row[1])) for row in rows]


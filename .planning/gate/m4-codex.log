    86	class EvidenceMappingAgent(Agent[EvidenceMatchInput, EvidenceMatchOutput]):
    87	    name = "evidence_mapping"
    88	    tier = ModelTier.pro
    89	    output_model = EvidenceMatchOutput
    90	    system_prompt = (
    91	        "You map a solicitation requirement to the company's evidence. Decide matched/partial/"
    92	        "missing with a 0-1 score and cite the single best evidence ref. Be conservative: weak "
    93	        "or tangential evidence is 'partial', not 'matched'. JSON only."
    94	    )
    95	
    96	    def build_prompt(self, data: EvidenceMatchInput) -> str:
    97	        candidates = (
    98	            "\n".join(f"- [{c.ref}] {c.content[:300]}" for c in data.candidates) or "(none)"
    99	        )
   100	        return (
   101	            f"Requirement ({data.requirement_category}): {data.requirement_text}\n\n"
   102	            f"Candidate evidence:\n{candidates}\n\n"
   103	            "Return status, score (0-1), best_ref (the matching evidence ref or null), rationale."
   104	        )
   105	
   106	    async def mock_output(self, ctx: AgentContext, data: EvidenceMatchInput) -> EvidenceMatchOutput:
   107	        req_words = _significant_words(data.requirement_text)
   108	        if not req_words:
   109	            return EvidenceMatchOutput(
   110	                status="missing", score=0.0, rationale="Requirement has no scoreable terms."
   111	            )
   112	
   113	        best_ref: str | None = None
   114	        best_score = 0.0
   115	        for candidate in data.candidates:
   116	            cand_words = _significant_words(candidate.content)
   117	            if not cand_words:
   118	                continue
   119	            overlap = len(req_words & cand_words) / len(req_words)
   120	            if overlap > best_score:
   121	                best_score = overlap
   122	                best_ref = candidate.ref
   123	
   124	        if best_score >= 0.45:
   125	            status = "matched"
   126	        elif best_score >= 0.2:
   127	            status = "partial"
   128	        else:
   129	            status = "missing"
   130	            best_ref = None
   131	
   132	        rationale = (
   133	            f"Best evidence covers {round(best_score * 100)}% of the requirement's key terms."
   134	            if best_ref
   135	            else "No evidence in the vault addresses this requirement."
   136	        )
   137	        return EvidenceMatchOutput(
   138	            status=status, score=round(best_score, 3), best_ref=best_ref, rationale=rationale
   139	        )


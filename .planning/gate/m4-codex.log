    72	
    73	class EvidenceMatchInput(BaseModel):
    74	    requirement_text: str
    75	    requirement_category: str = "other"
    76	    candidates: list[EvidenceCandidate] = Field(default_factory=list)
    77	
    78	
    79	class EvidenceMatchOutput(BaseModel):
    80	    status: str  # matched / partial / missing
    81	    score: float  # 0-1 match strength

   199	        (
   200	            await session.execute(
   201	                select(EvidenceItem).where(
   202	                    EvidenceItem.id.in_(ev_ids), EvidenceItem.org_id == org_id
   203	                )
   204	            )
   205	        )
   206	        .scalars()
   207	        .all()
   208	    )
   209	    src_ids = {it.source_id for it in items if it.source_id}
   210	    sources = (
   211	        {
   212	            s.id: s
   213	            for s in (await session.execute(select(Source).where(Source.id.in_(src_ids))))
   214	            .scalars()
   215	            .all()
   216	        }
   217	        if src_ids
   218	        else {}
   219	    )
   220	    rows = ["# Citation Appendix", ""]
   221	    appendix_citations: list[dict] = []
   222	    for i, item in enumerate(items, 1):
   223	        src = sources.get(item.source_id)
   224	        origin = f"{src.kind}: {src.title or src.url or src.id}" if src else "evidence vault"
   225	        rows.append(f"[E{i}] {item.content[:280]} — _source: {origin}_")
   226	        appendix_citations.append(
   227	            {
   228	                "evidence_item_id": str(item.id),
   229	                "source_id": str(item.source_id) if item.source_id else None,
   230	            }
   231	        )
   232	    return "\n".join(rows), appendix_citations

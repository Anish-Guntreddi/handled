    35	def _emit(pdf: FPDF, text: str, *, size: int, bold: bool) -> None:
    36	    # Wrap to a char width scaled to the font so even a long unbreakable token fits the page;
    37	    # fpdf2 raises if a single glyph can't fit, so we never hand it an over-wide line.
    38	    pdf.set_font("Helvetica", "B" if bold else "", size)
    39	    width = max(24, int(880 / size))
    40	    for chunk in textwrap.wrap(text, width=width, break_long_words=True) or [""]:
    41	        pdf.set_x(pdf.l_margin)
    42	        pdf.multi_cell(0, size * 0.55 + 1, _latinize(chunk) or " ")
    43	
    44	
    45	def _render_pdf(title: str, docs: list[tuple[str, str]]) -> bytes:
    46	    pdf = FPDF()
    47	    pdf.set_auto_page_break(auto=True, margin=15)
    48	    pdf.add_page()
    49	    _emit(pdf, title, size=16, bold=True)
    50	    pdf.ln(2)
    51	    for _doc_type, content_md in docs:
    52	        for line in content_md.splitlines():
    53	            if line.startswith("# "):
    54	                _emit(pdf, line[2:].strip(), size=14, bold=True)
    55	            elif line.startswith("## "):
    56	                _emit(pdf, line[3:].strip(), size=12, bold=True)
    57	            else:
    58	                _emit(pdf, line, size=10, bold=False)
    59	        pdf.ln(3)
    60	    return bytes(pdf.output())  # bytearray in fpdf2 >= 2.8
    61	
    62	
    63	def _render_docx(title: str, docs: list[tuple[str, str]]) -> bytes:
    64	    document = DocxDocument()
    65	    document.add_heading(title, level=0)
    66	    for _doc_type, content_md in docs:
    67	        for line in content_md.splitlines():
    68	            if line.startswith("## "):
    69	                document.add_heading(line[3:].strip(), level=2)
    70	            elif line.startswith("# "):
    71	                document.add_heading(line[2:].strip(), level=1)
    72	            elif line.strip().startswith(("- ", "* ")):
    73	                document.add_paragraph(line.strip()[2:], style="List Bullet")
    74	            elif line.strip():
    75	                document.add_paragraph(line)
    76	        document.add_page_break()
    77	    buffer = io.BytesIO()
    78	    document.save(buffer)
    79	    return buffer.getvalue()

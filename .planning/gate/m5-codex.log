   192	async def _citation_appendix(
   193	    session, org_id: uuid.UUID, citations: list[dict]
   194	) -> tuple[str, list[dict]]:
   195	    ev_ids = {uuid.UUID(c["evidence_item_id"]) for c in citations if c.get("evidence_item_id")}
   196	    if not ev_ids:
   197	        return "# Citation Appendix\n\nNo citations yet.", []

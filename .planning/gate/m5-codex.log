   258	async def validate_citations(ctx: StepContext) -> None:
   259	    """CON-2 gate: a document is citation_validated only when every citation resolves to a real
   260	    evidence_item/source, and claim-bearing documents carry at least one such citation."""
   261	    session = ctx.session
   262	    filing = await _load_filing(ctx)
   263	    docs = await _latest_docs(session, filing.id)
   264	
   265	    ev_ids = {
   266	        str(i)
   267	        for i in (
   268	            await session.execute(select(EvidenceItem.id).where(EvidenceItem.org_id == ctx.org_id))
   269	        )
   270	        .scalars()
   271	        .all()
   272	    }
   273	    src_ids = {
   274	        str(i)
   275	        for i in (await session.execute(select(Source.id).where(Source.org_id == ctx.org_id)))
   276	        .scalars()
   277	        .all()
   278	    }
   279	
   280	    validated = 0
   281	    for doc in docs:
   282	        entries = doc.citations or []
   283	        all_resolve = all(
   284	            (c.get("evidence_item_id") in ev_ids) or (c.get("source_id") in src_ids)
   285	            for c in entries
   286	        )
   287	        non_empty_ok = bool(entries) if doc.type in _CLAIM_BEARING else True
   288	        doc.citation_validated = bool(all_resolve and non_empty_ok)
   289	        doc.status = (
   290	            GeneratedDocStatus.review.value
   291	            if doc.citation_validated
   292	            else GeneratedDocStatus.draft.value
   293	        )
   294	        if doc.citation_validated:
   295	            validated += 1
   296	
   297	    filing.status = FilingStatus.package_review.value
   298	    await session.flush()
   299	    ctx.merge_results(
   300	        validatedDocuments=validated,
   301	        totalDocuments=len(docs),
   302	        allCitationsValid=validated == len(docs) and len(docs) > 0,
   303	    )


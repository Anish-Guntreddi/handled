     1	"""Compliance matrix: the live filing_requirements ⋈ evidence_matches view (FR-EM-4).
     2	
     3	Computed on read so it always reflects the current match state. A gap is any row whose status
     4	is partial or missing."""
     5	
     6	from __future__ import annotations
     7	
     8	import uuid
     9	
    10	from sqlalchemy import select
    11	from sqlalchemy.ext.asyncio import AsyncSession
    12	
    13	from captureos.models.enums import MatchStatus
    14	from captureos.models.evidence import EvidenceItem
    15	from captureos.models.filings import EvidenceMatch, FilingRequirement
    16	
    17	_GAP_STATUSES = (MatchStatus.partial.value, MatchStatus.missing.value)
    18	
    19	
    20	async def build_compliance_matrix(session: AsyncSession, filing_id: uuid.UUID) -> list[dict]:
    21	    requirements = (
    22	        (
    23	            await session.execute(
    24	                select(FilingRequirement)
    25	                .where(FilingRequirement.filing_id == filing_id)
    26	                .order_by(FilingRequirement.category, FilingRequirement.created_at)
    27	            )
    28	        )
    29	        .scalars()
    30	        .all()
    31	    )
    32	    matches = {
    33	        m.requirement_id: m
    34	        for m in (
    35	            await session.execute(select(EvidenceMatch).where(EvidenceMatch.filing_id == filing_id))
    36	        )
    37	        .scalars()
    38	        .all()
    39	    }
    40	    evidence_ids = [m.evidence_item_id for m in matches.values() if m.evidence_item_id]
    41	    evidence = {}
    42	    if evidence_ids:
    43	        evidence = {
    44	            e.id: e
    45	            for e in (
    46	                await session.execute(select(EvidenceItem).where(EvidenceItem.id.in_(evidence_ids)))
    47	            )
    48	            .scalars()
    49	            .all()
    50	        }
    51	
    52	    rows: list[dict] = []
    53	    for req in requirements:
    54	        match = matches.get(req.id)
    55	        status = match.status if match else MatchStatus.missing.value
    56	        ev = evidence.get(match.evidence_item_id) if match and match.evidence_item_id else None
    57	        rows.append(
    58	            {
    59	                "requirement_id": req.id,
    60	                "requirement": req.text,
    61	                "category": req.category,
    62	                "mandatory": req.mandatory,
    63	                "locator": req.locator,
    64	                "source_id": req.source_id,
    65	                "status": status,
    66	                "score": float(match.score) if match else 0.0,
    67	                "evidence": ev.content if ev else None,
    68	                "evidence_item_id": ev.id if ev else None,
    69	                "rationale": match.rationale if match else None,
    70	            }
    71	        )
    72	    return rows
    73	
    74	
    75	def gap_rows(matrix: list[dict]) -> list[dict]:
    76	    return [r for r in matrix if r["status"] in _GAP_STATUSES]
    77	
    78	
    79	def match_summary(matrix: list[dict]) -> dict[str, int]:
    80	    summary = {"matched": 0, "partial": 0, "missing": 0, "user_provided": 0}
    81	    for row in matrix:
    82	        summary[row["status"]] = summary.get(row["status"], 0) + 1
    83	    return summary


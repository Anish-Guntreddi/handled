    82	def render_export(fmt: str, title: str, docs: list[tuple[str, str]]) -> tuple[bytes, str, str]:
    83	    """Return (bytes, media_type, filename) for the requested format."""
    84	    safe_title = "".join(c if c.isalnum() else "_" for c in title)[:48] or "filing_package"
    85	    if fmt == "md":
    86	        return (
    87	            _combined_markdown(title, docs).encode("utf-8"),

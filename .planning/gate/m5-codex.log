    92	        return _render_pdf(title, docs), MEDIA_TYPES["pdf"], f"{safe_title}.pdf"
    93	    if fmt == "docx":
    94	        return _render_docx(title, docs), MEDIA_TYPES["docx"], f"{safe_title}.docx"
    95	    raise ValueError(f"Unsupported export format: {fmt}")


    21	
    22	
    23	def _latinize(text: str) -> str:
    24	    return text.translate(_LATIN1).encode("latin-1", "replace").decode("latin-1")
    25	
    26	
    27	def _combined_markdown(title: str, docs: list[tuple[str, str]]) -> str:
    28	    parts = [f"# {title}", ""]
    29	    for _doc_type, content_md in docs:
    30	        parts.append(content_md)
    31	        parts.append("\n---\n")
    32	    return "\n".join(parts)
    33	

# =========================================================================
# CaptureOS configuration contract.
# Copy to `.env` and fill in. Everything has a working local-first default,
# so the app runs end-to-end with NO cloud credentials. Drop in real keys to
# switch providers — no code change (see PROJECT.md "Local-first, cloud-ready").
# =========================================================================

# ---- Core ----
CAPTUREOS_ENV=local                  # local | staging | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated allowed CORS origins for the web app.
CORS_ALLOW_ORIGINS=http://localhost:3000

# ---- Auth (CON-4: server-side only) ----
AUTH_PROVIDER=local                  # local | firebase
# Local JWT signing. CHANGE in any shared/prod environment. >=32 chars.
JWT_SECRET=dev-only-insecure-change-me-please-32chars-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=14
# Firebase (only if AUTH_PROVIDER=firebase)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Database (Postgres + pgvector) ----
POSTGRES_USER=captureos
POSTGRES_PASSWORD=captureos
POSTGRES_DB=captureos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full async URL used by the app (override to point at Cloud SQL).
DATABASE_URL=postgresql+asyncpg://captureos:captureos@localhost:5432/captureos
# Sync URL used by Alembic migrations.
DATABASE_URL_SYNC=postgresql+psycopg://captureos:captureos@localhost:5432/captureos

# =============================================================================
# PRODUCTION / REAL MODE — to go live, set ONLY these 4 values. The SDKs
# (anthropic + google-genai) are already base dependencies: no code, no extra
# install, no DB migration. Claude runs the agents; Gemini runs embeddings.
#     LLM_PROVIDER=anthropic         ANTHROPIC_API_KEY=sk-ant-...
#     EMBEDDINGS_PROVIDER=gemini     GEMINI_API_KEY=...
# Embeddings and the LLM are independent — mixing Gemini embeddings with the
# Claude LLM is a standard, supported pairing. See docs/orchestration.md.
# =============================================================================

# ---- LLM provider (D4) ----
LLM_PROVIDER=mock                    # mock | gemini | anthropic   (production: anthropic)
GEMINI_API_KEY=                      # also powers Gemini embeddings below
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
# Anthropic Claude: set LLM_PROVIDER=anthropic and paste a key to enable. pro tier = reasoning
# agents (bid/no-bid, narrative), flash tier = high-volume extraction. Models are overridable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRO=claude-opus-4-8
ANTHROPIC_MODEL_FLASH=claude-haiku-4-5
# Per-lane provider override (optional; default = LLM_PROVIDER). Run the cheap extraction lane and
# the reasoning lane on DIFFERENT providers, e.g. Gemini Flash extraction + Claude reasoning:
#   LLM_PROVIDER_PRO=anthropic     (reasoning: bid/no-bid, requirement interpretation, narrative)
#   LLM_PROVIDER_FLASH=gemini      (extraction / high-volume)
LLM_PROVIDER_PRO=
LLM_PROVIDER_FLASH=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---- Embeddings (D7) ----
EMBEDDINGS_PROVIDER=mock             # mock | gemini   (production: gemini, uses GEMINI_API_KEY)
EMBEDDING_MODEL=gemini-embedding-001 # current GA Gemini model; output dim pinned to 768 below
# EMBEDDING_DIM is pinned to the pgvector column dimension. Do NOT change it after ingesting
# real documents — a different dimension requires a migration AND re-embedding every chunk.
EMBEDDING_DIM=768

# ---- Government corpus (KB) — shared, public-domain reference docs fed into the vector store ----
# eCFR "title:part" targets — FAR small business, SBA set-aside programs, grants Uniform Guidance
CORPUS_ECFR_TARGETS=48:19,13:121,13:124,13:125,13:126,13:127,2:200,13:120,13:123,48:2,48:4,48:9,48:12,48:13,48:15,48:52,2:25,2:170,2:180
CORPUS_FIRECRAWL_FORM_URLS=           # comma list of form/guidance URLs for Firecrawl to scrape
FIRECRAWL_API_KEY=                    # only needed to scrape the HTML/form long tail
# Run one ingest pass with:  python -m captureos.corpus.sync   (a cron triggers this later)

# ---- Blob storage ----
STORAGE_PROVIDER=local               # local | gcs
STORAGE_LOCAL_DIR=./.data/blobs
GCS_BUCKET=

# ---- Queue / async workflow dispatch ----
QUEUE_PROVIDER=local                 # local (DB-backed) | pubsub
PUBSUB_PROJECT_ID=
PUBSUB_TOPIC=captureos-workflow-steps

# ---- Document parsing ----
DOCPARSE_PROVIDER=local              # local (pdf/docx/text) | docai
DOCAI_PROCESSOR_ID=
DOCAI_LOCATION=us

# ---- Audit sink (D6) ----
AUDIT_SINK=postgres                  # postgres | bigquery
BIGQUERY_DATASET=captureos_audit
BIGQUERY_TABLE=events

# ---- Secrets backend (CON-4) ----
SECRETS_BACKEND=env                  # env | gcp_secret_manager
GCP_PROJECT_ID=

# ---- Billing (Stripe) ----
BILLING_PROVIDER=mock                # mock | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AUDIT=
STRIPE_PRICE_SPRINT=
STRIPE_PRICE_AUTOPILOT=

# ---- External source adapters (NFR-7: politeness) ----
SAM_GOV_API_KEY=
GRANTS_GOV_BASE_URL=https://api.grants.gov/v1/api
USASPENDING_BASE_URL=https://api.usaspending.gov/api/v2
SOURCE_FETCH_CACHE_TTL_SECONDS=86400
SOURCE_FETCH_RATE_LIMIT_PER_MIN=30

# ---- Cost guard (NFR-6) ----
WORKFLOW_TOKEN_BUDGET=200000

# ---- Frontend (Next.js; only NEXT_PUBLIC_* reach the browser) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_PROVIDER=local
